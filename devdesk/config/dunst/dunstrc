# devdesk · dunst — colours live in dunstrc.d/10-colors.conf (generated by pywal)
[global]
    font = JetBrainsMono Nerd Font 10
    width = (250, 380)
    origin = top-right
    offset = (16, 40)
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    gap_size = 6
    corner_radius = 8
    separator_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    mouse_left_click = close_current
    mouse_right_click = close_all

[urgency_low]
    timeout = 4
[urgency_normal]
    timeout = 7
[urgency_critical]
    timeout = 0
